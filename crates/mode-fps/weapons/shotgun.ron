// Pump shotgun: 8 pellets per shot, 70 rpm. Damage is per pellet.
(
    id: "shotgun",
    kind: Hitscan,
    fire_mode: Semi,
    rpm: 70.0,
    pellets: 8,
    damage: (
        base: 11.0,
        head_multiplier: 1.5,
        falloff_start: 6.0,
        falloff_end: 25.0,
        min_multiplier: 0.15,
    ),
    magazine: 6,
    reserve: 30,
    reload_time: 3.0,
    draw_time: 0.7,
    range: 100.0,
    spread: (
        sigma_base: 0.045,
        sigma_max: 0.12,
        delta_beta: 0.02,
        tau: 0.5,
        move_multiplier: 1.3,
        air_multiplier: 1.6,
    ),
    recoil: (
        pattern: [(0.0, 0.05)],
        random_fraction: 0.15,
        omega: 10.0,
    ),
    sight: (fov: 1.2, spread_multiplier: 0.8, speed_multiplier: 0.9),
)
