// Ambience profile "underwater": dense blue-green fog, soft light from above (caustics in 2.8).
// Colours are linear RGB. See `render::AmbienceProfile`.
(
    sun: (color: (0.50, 0.85, 0.90), intensity: 0.6, direction: (0.2, 1.0, 0.1), source: Profile),
    ambient: (ground: (0.02, 0.08, 0.10), sky: (0.08, 0.25, 0.30)),
    ramp: (threshold: 0.3, softness: 0.2, shadow: (0.10, 0.20, 0.25)),
    rim: (color: (0.05, 0.12, 0.12), power: 2.0),
    fog: (color: (0.03, 0.22, 0.28), density: 0.08, falloff: 0.02, height: 0.0),
    sky: (horizon: (0.05, 0.30, 0.35), zenith: (0.10, 0.45, 0.50), exponent: 0.5, stars: 0.0),
    shadow: (depth_bias: 1.0, slope_bias: 1.5, normal_offset: 1.0),
    weather: (kind: Clear, intensity: 0.0, wind: 0.0, heat_haze: 0.0),
    exposure: 1.0,
    grading: (
        lift: (0.0, 0.0, 0.0),
        gamma: (1.0, 1.0, 1.0),
        gain: (1.0, 1.0, 1.0),
        saturation: 1.0,
        hue_shift: 0.0,
        bloom_threshold: 1.0,
        bloom_intensity: 0.1,
    ),
    water: (shallow: (0.10, 0.50, 0.50), deep: (0.01, 0.08, 0.12), fog_density: 0.15, caustics: 1.0),
)
