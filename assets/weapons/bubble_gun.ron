        Sphere(radius: 0.07, subdivisions: 1, at: (0.0, 0.17, -0.05), color: "accent2"),
        Box(size: (0.08, 0.03, 0.09), at: (0.0, 0.11, -0.05), color: "white"),
        Box(size: (0.05, 0.05, 0.12), at: (0.0, 0.075, -0.26), color: "white"),
        Torus(major_radius: 0.06, minor_radius: 0.012, major_segments: 10, minor_segments: 4, at: (0.0, 0.075, -0.36), color: "accent2"),
        Box(size: (0.02, 0.02, 0.1), at: (0.0, 0.075, -0.3), color: "metal"),
        Box(size: (0.04, 0.12, 0.05), at: (0.0, -0.03, 0.04), color: "accent4"),
        Box(size: (0.012, 0.03, 0.012), at: (0.0, 0.0, -0.06), color: "white"),
