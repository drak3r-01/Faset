// Arena Zero: abstract duel arena. Free-for-all, 2 to 8 players, Rotate180
// (the file describes the half z >= 0; all spawns are `Any`). Principle:
// pure duel, jump pads, central pickups. A 38 m square of grid tiles: the
// armour and the rocket launcher sit on a raised central plate, health on
// two corner towers; jump pads throw players onto the plate and the
// opposite tower.
//
//   z=20 +-----------------------------------+
//        | S1          [pad]         S2      |
//        |       [p]                         |
//        |              ^ ramp     [ tower ] |
//        | [p] [pad]                [stairs> |
//    z=0 |          [ central plate ]      S3|  rotation centre
Map(
    format_version: 1,
    meta: (
        name: "Arena Zero",
        author: "Faset",
        description: "A bare neon square built for duels: control the centre, use the pads.",
        modes: ["fps"],
        players: (2, 8),
    ),
    theme: (
        ambience: "night",
        sky: "stars",
        palette: "neon",
    ),
    symmetry: Rotate180,
    brushes: [
        // Floor and walls.
        Box(min: (-40, -2, 0), max: (40, 0, 40), material: "grid"),
        Box(min: (-40, 0, 0), max: (-38, 20, 40), material: "hologram"),
        Box(min: (38, 0, 0), max: (40, 20, 40), material: "hologram"),
        Box(min: (-40, 0, 38), max: (40, 20, 40), material: "hologram"),
        // Central plate (2 m) and its ramp.
        Box(min: (-8, 0, 0), max: (8, 4, 8), material: "emissive"),
        Wedge(min: (-4, 0, 8), max: (4, 4, 16), rise: NegZ, material: "grid"),
        // Corner tower (5 m) and its stairs.
        Box(min: (24, 0, 16), max: (36, 10, 28), material: "grid"),
        Stairs(min: (8, 0, 16), max: (24, 10, 22), rise: PosX, steps: 10, material: "emissive"),
        // Pillars.
        Box(min: (-24, 0, 8), max: (-20, 8, 12), material: "hologram"),
        Box(min: (-16, 0, 28), max: (-12, 8, 32), material: "hologram"),
    ],
    spawns: [
        (at: (-16.0, 0.0, 17.0), yaw: 315.0, team: Any),
        (at: (8.0, 0.0, 17.0), yaw: 25.0, team: Any),
        (at: (17.0, 0.0, 5.0), yaw: 75.0, team: Any),
        (at: (-17.0, 0.0, 4.0), yaw: 285.0, team: Any),
    ],
    pickups: [
        (kind: Armor, at: (1.5, 2.5, 1.5), respawn_s: 30),
        (kind: Weapon("boomer_rocket_launcher"), at: (0.0, 2.5, 3.0), respawn_s: 30),
        (kind: Health, at: (15.0, 5.5, 11.0), respawn_s: 25),
        (kind: Health, at: (-10.0, 0.5, 12.0), respawn_s: 25),
    ],
    zones: [
        Box(min: (-42, -20, 0), max: (42, -4, 42), kind: KillVolume),
        // Pads: north edge onto the plate, west side onto the opposite tower.
        Box(min: (-2, 0, 30), max: (2, 1, 34), kind: JumpPad(velocity: (0.0, 10.0, -7.0))),
        Box(min: (-32, 0, 4), max: (-28, 1, 8), kind: JumpPad(velocity: (0.0, 12.0, -6.0))),
    ],
    lights: [
        (at: (0.0, 6.0, 0.0), color: (0.3, 0.9, 1.0), intensity: 2.5, range: 20.0),
        (at: (15.0, 8.0, 11.0), color: (1.0, 0.3, 0.8), intensity: 1.5, range: 12.0),
    ],
)
