// Toybox: a child's bedroom seen at toy size. Team map, 16 players,
// Rotate180 (the file describes the team A half, z >= 0). Principle:
// miniature players, shifted scale. Furniture and toys are giant: an 8 m
// high table climbed by a ruler, 4 m building blocks climbed by a stack of
// books, a 10 m crayon and a toy train as cover.
//
//   z=30 +--------------------------------------+
//        |  A   A   A   A   A   A   A   A (z=26)|
//        |        [B2]   [ train ]   (crayon)   |
//        |books>[ B1 ]                          |
//    z=8 |      leg[   table top 8 m   ]leg     |
//        |         [                   ]<ruler  |
//    z=0 +---------[-------------------]--------+  rotation centre
Map(
    format_version: 1,
    meta: (
        name: "Toybox",
        author: "Faset",
        description: "Fight at toy size across a bedroom floor, a towering table and building blocks.",
        modes: ["fps"],
        players: (2, 16),
    ),
    theme: (
        ambience: "day",
        palette: "interior",
    ),
    symmetry: Rotate180,
    brushes: [
        // Floorboards and room walls.
        Box(min: (-60, -2, 0), max: (60, 0, 60), material: "wood"),
        Box(min: (-60, 0, 0), max: (-58, 32, 60), material: "tiles"),
        Box(min: (58, 0, 0), max: (60, 32, 60), material: "tiles"),
        Box(min: (-60, 0, 58), max: (60, 32, 60), material: "tiles"),
        // Table: top at 8 m, legs, and the ruler leaning on it.
        Box(min: (-20, 14, 0), max: (20, 16, 16), material: "wood"),
        Box(min: (-20, 0, 12), max: (-16, 14, 16), material: "wood"),
        Box(min: (16, 0, 12), max: (20, 14, 16), material: "wood"),
        Wedge(min: (20, 0, 6), max: (48, 16, 12), rise: NegX, material: "checker"),
        // Building blocks and the book stack.
        Box(min: (-44, 0, 20), max: (-32, 8, 32), material: "checker"),
        Stairs(min: (-58, 0, 22), max: (-44, 8, 30), rise: PosX, steps: 9, material: "hazard"),
        Box(min: (-28, 0, 36), max: (-20, 8, 44), material: "hazard"),
        // Crayon and toy train.
        Cylinder(min: (28, 0, 28), max: (36, 20, 36), axis: Y, sides: 8, material: "container_red"),
        Box(min: (-8, 0, 28), max: (8, 4, 32), material: "container_blue"),
        Cylinder(min: (-6, 0, 26), max: (-2, 4, 28), axis: Z, sides: 10, material: "metal"),
        Cylinder(min: (2, 0, 26), max: (6, 4, 28), axis: Z, sides: 10, material: "metal"),
    ],
    props: [
        (recipe: "storage_chest", at: (24.0, 0.0, 24.0), yaw: 0.0, scale: 2.0),
        (recipe: "potted_plant", at: (-26.0, 0.0, 4.0), yaw: 0.0, scale: 2.0),
        (recipe: "rug", at: (-6.0, 0.0, 20.0), yaw: 15.0),
        (recipe: "wooden_stool", at: (12.0, 0.0, 20.0), yaw: 30.0, scale: 2.0),
    ],
    spawns: [
        (at: (-21.0, 0.0, 26.0), yaw: 0.0, team: A),
        (at: (-15.0, 0.0, 26.0), yaw: 0.0, team: A),
        (at: (-9.0, 0.0, 26.0), yaw: 0.0, team: A),
        (at: (-3.0, 0.0, 26.0), yaw: 0.0, team: A),
        (at: (3.0, 0.0, 26.0), yaw: 0.0, team: A),
        (at: (9.0, 0.0, 26.0), yaw: 0.0, team: A),
        (at: (15.0, 0.0, 26.0), yaw: 0.0, team: A),
        (at: (21.0, 0.0, 26.0), yaw: 0.0, team: A),
    ],
    pickups: [
        (kind: Health, at: (4.0, 8.5, 2.0), respawn_s: 30),
        (kind: Armor, at: (-19.0, 4.5, 13.0), respawn_s: 45),
        (kind: Health, at: (25.0, 0.5, 10.0), respawn_s: 30),
        (kind: Weapon("rubber_chicken_launcher"), at: (-4.0, 0.5, 4.0), respawn_s: 40),
    ],
    zones: [
        Box(min: (-62, -20, 0), max: (62, -4, 62), kind: KillVolume),
    ],
    lights: [
        (at: (0.0, 14.0, 20.0), color: (1.0, 0.9, 0.7), intensity: 2.0, range: 24.0),
        (at: (0.0, 6.0, 0.0), color: (1.0, 0.85, 0.6), intensity: 1.0, range: 12.0),
    ],
)
