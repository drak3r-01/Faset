// Sunken Temple: overgrown jungle temple in the rain. Team map, 16 players,
// Rotate180 (the file describes the team A half, z >= 0). Principle: loop
// around a central courtyard. A raised 8 m wide colonnade ring (2 m high)
// encloses a 24 m courtyard with the altar; ramps lead from the jungle up
// to the ring and from the ring down into the courtyard, so fights circle
// the loop or cut through the middle.
//
//   z=30 +-----------------------------------------+
//        |  A   A   A   A   A   A   A   A  (z=26)  |
//   z=20 |   +--ramp--------ring--------ramp--+    |
//        |   |  o    o    o    o    o    o    |    |  colonnade
//   z=12 |ramp|  +-------v ramp--------+   |  ring |
//        |   |  |  courtyard  (altar) |<ramp|     |
//    z=0 +---+--+---------------------+-----+-----+  rotation centre
Map(
    format_version: 1,
    meta: (
        name: "Sunken Temple",
        author: "Faset",
        description: "Circle a rain-soaked colonnade or dive into the courtyard around the altar.",
        modes: ["fps"],
        players: (2, 16),
    ),
    theme: (
        ambience: "storm",
        sky: "overcast",
        weather: [(from_s: 0.0, weather: "rain")],
        palette: "nature",
    ),
    symmetry: Rotate180,
    brushes: [
        // Jungle floor and cliffs.
        Box(min: (-60, -2, 0), max: (60, 0, 60), material: "sand"),
        Box(min: (-60, 0, 0), max: (-58, 20, 60), material: "concrete"),
        Box(min: (58, 0, 0), max: (60, 20, 60), material: "concrete"),
        Box(min: (-60, 0, 58), max: (60, 20, 60), material: "concrete"),
        // Colonnade ring (2 m high, 8 m wide).
        Box(min: (-40, 0, 24), max: (40, 4, 40), material: "brick"),
        Box(min: (24, 0, 0), max: (40, 4, 24), material: "brick"),
        Box(min: (-40, 0, 0), max: (-24, 4, 24), material: "brick"),
        // Ramps from the ring down into the courtyard.
        Wedge(min: (-4, 0, 16), max: (4, 4, 24), rise: PosZ, material: "tiles"),
        Wedge(min: (16, 0, 4), max: (24, 4, 12), rise: PosX, material: "tiles"),
        // Ramps from the jungle up to the ring.
        Wedge(min: (-28, 0, 40), max: (-20, 4, 48), rise: NegZ, material: "brick"),
        Wedge(min: (20, 0, 40), max: (28, 4, 48), rise: NegZ, material: "brick"),
        Wedge(min: (40, 0, 8), max: (48, 4, 16), rise: NegX, material: "brick"),
        Wedge(min: (-48, 0, 12), max: (-40, 4, 20), rise: PosX, material: "brick"),
        // Colonnade pillars along the inner edge of the ring.
        Cylinder(min: (-33, 4, 25), max: (-31, 12, 27), axis: Y, sides: 8, material: "brick"),
        Cylinder(min: (-21, 4, 25), max: (-19, 12, 27), axis: Y, sides: 8, material: "brick"),
        Cylinder(min: (-9, 4, 25), max: (-7, 12, 27), axis: Y, sides: 8, material: "brick"),
        Cylinder(min: (7, 4, 25), max: (9, 12, 27), axis: Y, sides: 8, material: "brick"),
        Cylinder(min: (19, 4, 25), max: (21, 12, 27), axis: Y, sides: 8, material: "brick"),
        Cylinder(min: (31, 4, 25), max: (33, 12, 27), axis: Y, sides: 8, material: "brick"),
        Cylinder(min: (25, 4, 15), max: (27, 12, 17), axis: Y, sides: 8, material: "brick"),
        Cylinder(min: (-27, 4, 15), max: (-25, 12, 17), axis: Y, sides: 8, material: "brick"),
        // Architrave over the north pillars.
        Box(min: (-40, 12, 24), max: (40, 13, 28), material: "brick"),
        // Altar (1 m, low cover) and fallen blocks in the courtyard.
        Box(min: (-4, 0, -4), max: (4, 2, 4), material: "tiles"),
        Box(min: (8, 0, 12), max: (12, 2, 16), material: "brick"),
        // Ruined shrine in the jungle.
        Box(min: (-52, 0, 30), max: (-44, 6, 38), material: "brick"),
    ],
    props: [
        (recipe: "tree_oak", at: (-25.0, 0.0, 6.0), yaw: 0.0),
        (recipe: "tree_oak", at: (26.0, 0.0, 22.0), yaw: 40.0),
        (recipe: "fern", at: (-12.0, 0.0, 22.0), yaw: 0.0),
        (recipe: "bush", at: (14.0, 0.0, 23.0), yaw: 10.0),
        (recipe: "mossy_rock", at: (-5.0, 0.0, 9.0), yaw: 30.0),
        (recipe: "thorn_bush", at: (27.0, 0.0, 2.0), yaw: 0.0),
    ],
    spawns: [
        (at: (-21.0, 0.0, 26.0), yaw: 0.0, team: A),
        (at: (-15.0, 0.0, 26.0), yaw: 0.0, team: A),
        (at: (-9.0, 0.0, 26.0), yaw: 0.0, team: A),
        (at: (-3.0, 0.0, 26.0), yaw: 0.0, team: A),
        (at: (3.0, 0.0, 26.0), yaw: 0.0, team: A),
        (at: (9.0, 0.0, 26.0), yaw: 0.0, team: A),
        (at: (15.0, 0.0, 26.0), yaw: 0.0, team: A),
        (at: (21.0, 0.0, 26.0), yaw: 0.0, team: A),
    ],
    pickups: [
        (kind: Health, at: (6.0, 0.5, 2.5), respawn_s: 30),
        (kind: Armor, at: (16.0, 2.5, 6.0), respawn_s: 45),
        (kind: Weapon("pump_shotgun"), at: (0.0, 0.5, 5.0), respawn_s: 40),
        (kind: Health, at: (-25.0, 0.5, 2.0), respawn_s: 30),
    ],
    zones: [
        Box(min: (-62, -20, 0), max: (62, -4, 62), kind: KillVolume),
    ],
    lights: [
        (at: (0.0, 4.0, 0.0), color: (1.0, 0.6, 0.3), intensity: 1.5, range: 14.0),
        (at: (16.0, 5.0, 16.0), color: (1.0, 0.6, 0.3), intensity: 1.0, range: 10.0),
    ],
)
