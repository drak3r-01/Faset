// Underline: underground station. Team map, 16 players, MirrorZ (the file
// describes the team A half, z >= 0). Principle: corridors, trains,
// flanking routes. Two raised platforms flank two tracks where stopped
// trains split the lines of fire; gaps between the trains and ramps let
// players cross the tracks. Service corridors behind the platform walls are
// the flanking routes, with doorways onto the platforms. Spawns on the
// concourse at each end.
//
//   z=40 +---------------------------------------------+
//        |  concourse 1 m (8 spawns, z=35)             |
//   z=30 |stairs|wall| platform |tracks| platform |wall|stairs
//        | corr |door|   1 m    |[tr]  |   1 m    |door| corr
//        | 0 m  |    |          |[ain] [tr]       |    | 0 m
//    z=0 +------+----+----------+--ramps--+-------+----+------+  mirror plane
Map(
    format_version: 1,
    meta: (
        name: "Underline",
        author: "Faset",
        description: "A buried station of stopped trains, platform duels and service-tunnel flanks.",
        modes: ["fps"],
        players: (2, 16),
    ),
    theme: (
        ambience: "night",
        palette: "urban",
    ),
    symmetry: MirrorZ,
    brushes: [
        // Track bed, walls and ceiling (6 m).
        Box(min: (-48, -2, 0), max: (48, 0, 80), material: "concrete"),
        Box(min: (-48, 0, 0), max: (-46, 12, 80), material: "tiles"),
        Box(min: (46, 0, 0), max: (48, 12, 80), material: "tiles"),
        Box(min: (-48, 0, 78), max: (48, 12, 80), material: "tiles"),
        Box(min: (-48, 12, 0), max: (48, 14, 80), material: "concrete"),
        // Platforms (1 m) and concourse.
        Box(min: (-28, 0, 0), max: (-12, 2, 60), material: "tiles"),
        Box(min: (12, 0, 0), max: (28, 2, 60), material: "tiles"),
        Box(min: (-46, 0, 60), max: (46, 2, 78), material: "tiles"),
        // Walls between platforms and service corridors, doorways at z 10 and 22.
        Box(min: (-34, 0, 0), max: (-28, 12, 20), material: "tiles"),
        Box(min: (-34, 0, 24), max: (-28, 12, 44), material: "tiles"),
        Box(min: (-34, 0, 48), max: (-28, 12, 60), material: "tiles"),
        Box(min: (-34, 7, 20), max: (-28, 12, 24), material: "tiles"),
        Box(min: (-34, 7, 44), max: (-28, 12, 48), material: "tiles"),
        Box(min: (28, 0, 0), max: (34, 12, 20), material: "tiles"),
        Box(min: (28, 0, 24), max: (34, 12, 44), material: "tiles"),
        Box(min: (28, 0, 48), max: (34, 12, 60), material: "tiles"),
        Box(min: (28, 7, 20), max: (34, 12, 24), material: "tiles"),
        Box(min: (28, 7, 44), max: (34, 12, 48), material: "tiles"),
        // Steps in the doorways (corridor 0 m to platform 1 m).
        Stairs(min: (-34, 0, 20), max: (-28, 2, 24), rise: PosX, steps: 2, material: "concrete"),
        Stairs(min: (-34, 0, 44), max: (-28, 2, 48), rise: PosX, steps: 2, material: "concrete"),
        Stairs(min: (28, 0, 20), max: (34, 2, 24), rise: NegX, steps: 2, material: "concrete"),
        Stairs(min: (28, 0, 44), max: (34, 2, 48), rise: NegX, steps: 2, material: "concrete"),
        // Corridor stairs up to the concourse.
        Stairs(min: (-46, 0, 56), max: (-34, 2, 60), rise: PosZ, steps: 2, material: "concrete"),
        Stairs(min: (34, 0, 56), max: (46, 2, 60), rise: PosZ, steps: 2, material: "concrete"),
        // Stopped trains.
        Box(min: (-11, 0, 4), max: (-4, 7, 32), material: "metal"),
        Box(min: (-11, 7, 4), max: (-4, 8, 32), material: "hazard"),
        Box(min: (4, 0, 16), max: (11, 7, 52), material: "metal"),
        Box(min: (4, 7, 16), max: (11, 8, 52), material: "hazard"),
        // Ramps from the tracks up to the platforms.
        Wedge(min: (-12, 0, 0), max: (-8, 2, 4), rise: NegX, material: "concrete"),
        Wedge(min: (-12, 0, 40), max: (-8, 2, 48), rise: NegX, material: "concrete"),
        Wedge(min: (8, 0, 0), max: (12, 2, 8), rise: PosX, material: "concrete"),
        Wedge(min: (8, 0, 54), max: (12, 2, 60), rise: PosX, material: "concrete"),
        // Platform pillars.
        Box(min: (-21, 2, 40), max: (-19, 12, 42), material: "tiles"),
        Box(min: (19, 2, 16), max: (21, 12, 18), material: "tiles"),
    ],
    props: [
        (recipe: "street_bench", at: (-10.0, 1.0, 28.0), yaw: 90.0),
        (recipe: "trash_can", at: (10.0, 1.0, 4.0), yaw: 0.0),
        (recipe: "newspaper_box", at: (-18.0, 1.0, 37.0), yaw: 0.0),
        (recipe: "cardboard_stack", at: (-20.0, 0.0, 26.0), yaw: 20.0),
        (recipe: "vending_kiosk", at: (20.0, 0.0, 8.0), yaw: 270.0),
    ],
    spawns: [
        (at: (-21.0, 1.0, 35.0), yaw: 0.0, team: A),
        (at: (-15.0, 1.0, 35.0), yaw: 0.0, team: A),
        (at: (-9.0, 1.0, 35.0), yaw: 0.0, team: A),
        (at: (-3.0, 1.0, 35.0), yaw: 0.0, team: A),
        (at: (3.0, 1.0, 35.0), yaw: 0.0, team: A),
        (at: (9.0, 1.0, 35.0), yaw: 0.0, team: A),
        (at: (15.0, 1.0, 35.0), yaw: 0.0, team: A),
        (at: (21.0, 1.0, 35.0), yaw: 0.0, team: A),
    ],
    pickups: [
        (kind: Health, at: (-20.0, 0.5, 5.0), respawn_s: 30),
        (kind: Health, at: (20.0, 0.5, 16.0), respawn_s: 30),
        (kind: Armor, at: (0.0, 0.5, 1.0), respawn_s: 45),
        (kind: Weapon("smg"), at: (10.0, 1.5, 20.0), respawn_s: 40),
    ],
    zones: [
        Box(min: (-50, -20, 0), max: (50, -4, 82), kind: KillVolume),
    ],
    lights: [
        (at: (0.0, 5.5, 10.0), color: (0.9, 1.0, 0.95), intensity: 1.2, range: 14.0),
        (at: (0.0, 5.5, 25.0), color: (0.9, 1.0, 0.95), intensity: 1.2, range: 14.0),
        (at: (-20.0, 5.5, 15.0), color: (1.0, 0.85, 0.6), intensity: 0.8, range: 10.0),
        (at: (20.0, 5.5, 15.0), color: (1.0, 0.85, 0.6), intensity: 0.8, range: 10.0),
        (at: (0.0, 5.5, 35.0), color: (0.9, 1.0, 0.95), intensity: 1.4, range: 18.0),
    ],
)
