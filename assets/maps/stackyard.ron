// Stackyard: container dock at dusk. Small team map, 12 players, Rotate180 (the
// file describes the team A half, z >= 0). Principle: small map with
// constant action. A 38 m x 28 m yard of containers; the central container
// is climbed by stairs from both sides and holds the health.
//
//   z=15 +--------------------------------------+
//        | A  A    A     A    A    A  (z=12.5)  |
//        |       ====low wall====               |
//        |   [C4]                  [C3]         |
//        |   [C1 ]       [C2  ]    [  ]         |
//    z=0 |      stairs>[ C0 central ]<stairs    |  rotation centre
Map(
    format_version: 1,
    meta: (
        name: "Stackyard",
        author: "Faset",
        description: "A tight dusk-lit container yard where every lane meets the central stack.",
        modes: ["fps"],
        players: (2, 12),
    ),
    theme: (
        ambience: "sunset",
        sky: "dusk",
        palette: "industrial",
    ),
    symmetry: Rotate180,
    brushes: [
        // Ground and enclosure.
        Box(min: (-40, -2, 0), max: (40, 0, 30), material: "concrete"),
        Box(min: (-40, 0, 0), max: (-38, 12, 30), material: "metal"),
        Box(min: (38, 0, 0), max: (40, 12, 30), material: "metal"),
        Box(min: (-40, 0, 28), max: (40, 12, 30), material: "metal"),
        // Central container and its stairs.
        Box(min: (-6, 0, -3), max: (6, 5, 3), material: "container_red"),
        Stairs(min: (6, 0, -3), max: (14, 5, 3), rise: NegX, steps: 6, material: "metal"),
        // Container stacks.
        Box(min: (-28, 0, 10), max: (-16, 5, 15), material: "container_blue"),
        Box(min: (-28, 5, 10), max: (-22, 10, 15), material: "container_red"),
        Box(min: (4, 0, 8), max: (16, 5, 13), material: "container_red"),
        Box(min: (24, 0, 4), max: (29, 5, 16), material: "container_blue"),
        // Low wall in front of the spawns.
        Box(min: (-12, 0, 18), max: (0, 2, 20), material: "hazard"),
    ],
    props: [
        (recipe: "steel_crate", at: (-4.0, 0.0, 6.0), yaw: 15.0),
        (recipe: "oil_drum_stack", at: (10.0, 0.0, 2.5), yaw: 0.0),
        (recipe: "pallet_stack", at: (-12.0, 0.0, 2.0), yaw: 30.0),
        (recipe: "cable_spool", at: (18.0, 0.0, 10.0), yaw: 0.0),
    ],
    spawns: [
        (at: (-15.0, 0.0, 12.5), yaw: 0.0, team: A),
        (at: (-9.0, 0.0, 12.5), yaw: 0.0, team: A),
        (at: (-3.0, 0.0, 12.5), yaw: 0.0, team: A),
        (at: (3.0, 0.0, 12.5), yaw: 0.0, team: A),
        (at: (9.0, 0.0, 12.5), yaw: 0.0, team: A),
        (at: (15.0, 0.0, 12.5), yaw: 0.0, team: A),
    ],
    pickups: [
        (kind: Health, at: (1.5, 3.0, 0.0), respawn_s: 25),
        (kind: Health, at: (-17.0, 0.5, 2.0), respawn_s: 25),
        (kind: Weapon("pump_shotgun"), at: (0.0, 0.5, 6.0), respawn_s: 40),
    ],
    zones: [
        Box(min: (-42, -20, 0), max: (42, -4, 32), kind: KillVolume),
    ],
    lights: [
        (at: (0.0, 5.0, 0.0), color: (1.0, 0.7, 0.4), intensity: 2.0, range: 16.0),
        (at: (-12.0, 6.0, 10.0), color: (1.0, 0.8, 0.5), intensity: 1.2, range: 12.0),
    ],
)
