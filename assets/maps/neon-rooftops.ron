// Neon Rooftops: city roofs at night under neon signs. Team map, 16
// players, Rotate180 (the file describes the team A half, z >= 0).
// Principle: verticality, jump pads. Roofs at 4, 6, 8 and 12 m are linked by
// ramps and stairs bridging the street gaps (everything is walkable); jump
// pads give shortcuts up to the 12 m central tower. Falling into the street
// kills.
//
//   z=30 +--------------------------------------+
//        |  roof A, 8 m (8 spawns, z=25)  [pad] |
//   z=20 +--ramp--------------------------ramp--+
//        | roof M1 4 m |stairs> tower |<ramp roof M3 6 m |
//    z=4 |             |  M2 12 m     |                  |
//    z=0 +--bridge-----+--------------+--------------bridge  rotation centre
Map(
    format_version: 1,
    meta: (
        name: "Neon Rooftops",
        author: "Faset",
        description: "Rain-slick roofs at four heights, linked by ramps, stairs and jump pads.",
        modes: ["fps"],
        players: (2, 16),
    ),
    theme: (
        ambience: "neon",
        sky: "night",
        weather: [(from_s: 0.0, weather: "clear"), (from_s: 180.0, weather: "rain")],
        palette: "neon",
    ),
    symmetry: Rotate180,
    brushes: [
        // Buildings, from the street (y = -20 m) to their roofs.
        Box(min: (-60, -40, 40), max: (60, 16, 60), material: "concrete"),
        Box(min: (-60, -40, 8), max: (-24, 8, 32), material: "brick"),
        Box(min: (-16, -40, 0), max: (16, 24, 24), material: "metal"),
        Box(min: (24, -40, 8), max: (60, 12, 32), material: "concrete"),
        // Ramps and stairs over the street gaps.
        Wedge(min: (-52, 8, 24), max: (-44, 16, 40), rise: PosZ, material: "metal"),
        Wedge(min: (44, 12, 24), max: (52, 16, 40), rise: PosZ, material: "metal"),
        Stairs(min: (-40, 8, 12), max: (-16, 24, 20), rise: PosX, steps: 18, material: "metal"),
        Wedge(min: (16, 12, 4), max: (32, 24, 12), rise: NegX, material: "metal"),
        Wedge(min: (-48, 8, -8), max: (-40, 12, 8), rise: NegZ, material: "grid"),
        // Neon trims on the facades and signs.
        Box(min: (-60, 4, 32), max: (-24, 5, 33), material: "emissive"),
        Box(min: (24, 8, 32), max: (60, 9, 33), material: "hologram"),
        Box(min: (-60, 12, 39), max: (60, 13, 40), material: "emissive"),
        Box(min: (-8, 24, 22), max: (8, 28, 24), material: "hologram"),
        Box(min: (-8, 16, 56), max: (8, 22, 57), material: "emissive"),
        // Parapets (1.5 m) along the roof edges, open where ramps arrive.
        Box(min: (-60, 16, 40), max: (-52, 19, 41), material: "concrete"),
        Box(min: (-44, 16, 40), max: (44, 19, 41), material: "concrete"),
        Box(min: (52, 16, 40), max: (60, 19, 41), material: "concrete"),
        Box(min: (-60, 16, 41), max: (-59, 19, 60), material: "concrete"),
        Box(min: (59, 16, 41), max: (60, 19, 60), material: "concrete"),
        Box(min: (-60, 16, 59), max: (60, 19, 60), material: "concrete"),
        Box(min: (-60, 8, 31), max: (-52, 11, 32), material: "brick"),
        Box(min: (-44, 8, 31), max: (-24, 11, 32), material: "brick"),
        Box(min: (-25, 8, 8), max: (-24, 11, 12), material: "brick"),
        Box(min: (-25, 8, 20), max: (-24, 11, 31), material: "brick"),
        Box(min: (-60, 8, 8), max: (-59, 11, 32), material: "brick"),
        Box(min: (-60, 8, 8), max: (-48, 11, 9), material: "brick"),
        Box(min: (-40, 8, 8), max: (-25, 11, 9), material: "brick"),
        Box(min: (24, 12, 31), max: (44, 15, 32), material: "concrete"),
        Box(min: (52, 12, 31), max: (60, 15, 32), material: "concrete"),
        Box(min: (24, 12, 12), max: (25, 15, 31), material: "concrete"),
        Box(min: (59, 12, 8), max: (60, 15, 32), material: "concrete"),
        Box(min: (32, 12, 8), max: (40, 15, 9), material: "concrete"),
        Box(min: (48, 12, 8), max: (60, 15, 9), material: "concrete"),
        Box(min: (-16, 24, 0), max: (-15, 27, 12), material: "metal"),
        Box(min: (-16, 24, 20), max: (-15, 27, 22), material: "metal"),
        Box(min: (15, 24, 0), max: (16, 27, 4), material: "metal"),
        Box(min: (15, 24, 12), max: (16, 27, 22), material: "metal"),
        Box(min: (-16, 24, 23), max: (-8, 27, 24), material: "metal"),
        Box(min: (8, 24, 23), max: (16, 27, 24), material: "metal"),
        // Railings along the ramps, stairs and bridge over the street.
        Box(min: (-53, 8, 32), max: (-52, 19, 40), material: "metal"),
        Box(min: (-44, 8, 32), max: (-43, 19, 40), material: "metal"),
        Box(min: (43, 12, 32), max: (44, 19, 40), material: "metal"),
        Box(min: (52, 12, 32), max: (53, 19, 40), material: "metal"),
        Box(min: (-24, 8, 11), max: (-16, 27, 12), material: "metal"),
        Box(min: (-24, 8, 20), max: (-16, 27, 21), material: "metal"),
        Box(min: (16, 12, 3), max: (24, 27, 4), material: "metal"),
        Box(min: (16, 12, 12), max: (24, 27, 13), material: "metal"),
        Box(min: (-49, 8, -8), max: (-48, 15, 8), material: "metal"),
        Box(min: (-40, 8, -8), max: (-39, 15, 8), material: "metal"),
        // Rooftop cover: vents and a water tank.
        Box(min: (-36, 16, 44), max: (-30, 18, 46), material: "metal"),
        Box(min: (30, 16, 44), max: (36, 18, 46), material: "metal"),
        Cylinder(min: (-56, 8, 12), max: (-50, 14, 18), axis: Y, sides: 10, material: "wood"),
    ],
    props: [
        (recipe: "neon_barrier", at: (-9.0, 8.0, 21.5), yaw: 0.0),
        (recipe: "neon_barrier", at: (9.0, 8.0, 21.5), yaw: 0.0),
        (recipe: "vending_kiosk", at: (-26.0, 4.0, 5.5), yaw: 90.0),
        (recipe: "glow_bollard", at: (18.0, 6.0, 14.0), yaw: 0.0),
        (recipe: "speaker_stack", at: (28.0, 6.0, 5.0), yaw: 0.0),
    ],
    spawns: [
        (at: (-21.0, 8.0, 25.0), yaw: 0.0, team: A),
        (at: (-15.0, 8.0, 25.0), yaw: 0.0, team: A),
        (at: (-9.0, 8.0, 25.0), yaw: 0.0, team: A),
        (at: (-3.0, 8.0, 25.0), yaw: 0.0, team: A),
        (at: (3.0, 8.0, 25.0), yaw: 0.0, team: A),
        (at: (9.0, 8.0, 25.0), yaw: 0.0, team: A),
        (at: (15.0, 8.0, 25.0), yaw: 0.0, team: A),
        (at: (21.0, 8.0, 25.0), yaw: 0.0, team: A),
    ],
    pickups: [
        (kind: Health, at: (-20.0, 4.5, 13.0), respawn_s: 30),
        (kind: Armor, at: (4.0, 12.5, 4.0), respawn_s: 45),
        (kind: Weapon("precision_rifle"), at: (24.0, 6.5, 8.0), respawn_s: 45),
    ],
    zones: [
        Box(min: (-68, -60, 0), max: (68, -30, 68), kind: KillVolume),
        // Jump pads: roof A to the tower, roof M1 to the tower, M3 to the tower.
        Box(min: (-2, 16, 41), max: (2, 17, 44), kind: JumpPad(velocity: (0.0, 13.0, -9.0))),
        Box(min: (-32, 8, 24), max: (-28, 9, 28), kind: JumpPad(velocity: (9.0, 13.0, -4.0))),
        Box(min: (26, 12, 26), max: (30, 13, 30), kind: JumpPad(velocity: (-8.0, 12.0, -3.0))),
    ],
    lights: [
        (at: (-20.0, 6.0, 10.0), color: (1.0, 0.2, 0.8), intensity: 2.0, range: 16.0),
        (at: (20.0, 8.0, 10.0), color: (0.2, 0.9, 1.0), intensity: 2.0, range: 16.0),
        (at: (0.0, 14.0, 0.0), color: (0.7, 0.3, 1.0), intensity: 2.5, range: 18.0),
        (at: (0.0, 10.0, 25.0), color: (1.0, 0.3, 0.5), intensity: 1.5, range: 18.0),
    ],
)
