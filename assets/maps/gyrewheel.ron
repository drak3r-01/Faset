// Gyrewheel: space station. Team map, 16 players, MirrorZ (the file describes
// the team A half, z >= 0). Principle: low-gravity zones, corridors and
// airlocks. Each spawn module opens through an airlock wall (three 2 m
// doors) into three 4 m corridors with a service duct between them, then
// through a second airlock into the central hub, a 24 m low-gravity dome
// around the reactor. A balcony on the east side is reached by a ramp,
// floating platforms on the west side only by low-gravity jumps.
//
//   z=36 +---------------------------------------+
//        |  spawn module (8 spawns, z=31)        |
//   z=27 |==]  [===========]  [===========]  [===|  airlock 2
//        |##|  |###########|  |###########|  |###|
//        |##|  |=== duct ==|  |=== duct ==|  |###|  z=18..21
//        |##|  |###########|  |###########|  |###|
//   z=13 |==]  [===========]  [===========]  [===|  airlock 1
//        |  hub, LowGravity 0.35   (reactor)  bal|
//    z=0 +---------------------------------------+  mirror plane
Map(
    format_version: 1,
    meta: (
        name: "Gyrewheel",
        author: "Faset",
        description: "A ring station where airlocked corridors meet a low-gravity reactor dome.",
        modes: ["fps"],
        players: (2, 16),
    ),
    theme: (
        ambience: "space",
        sky: "stars",
        palette: "space",
    ),
    symmetry: MirrorZ,
    brushes: [
        // Hull: floor, ceiling at 12 m, walls.
        Box(min: (-40, -2, 0), max: (40, 0, 72), material: "metal"),
        Box(min: (-40, 24, 0), max: (40, 26, 72), material: "metal"),
        Box(min: (-40, 0, 0), max: (-38, 24, 72), material: "metal"),
        Box(min: (38, 0, 0), max: (40, 24, 72), material: "metal"),
        Box(min: (-40, 0, 70), max: (40, 24, 72), material: "metal"),
        // Airlock 1 (z 12..13): three 2 m x 2.5 m doors.
        Box(min: (-38, 0, 24), max: (-32, 24, 26), material: "grid"),
        Box(min: (-28, 0, 24), max: (-2, 24, 26), material: "grid"),
        Box(min: (2, 0, 24), max: (28, 24, 26), material: "grid"),
        Box(min: (32, 0, 24), max: (38, 24, 26), material: "grid"),
        Box(min: (-32, 5, 24), max: (-28, 24, 26), material: "hazard"),
        Box(min: (-2, 5, 24), max: (2, 24, 26), material: "hazard"),
        Box(min: (28, 5, 24), max: (32, 24, 26), material: "hazard"),
        // Corridor blocks (z 13..26), corridors 4 m wide, 3.5 m high.
        Box(min: (-38, 0, 26), max: (-34, 24, 52), material: "metal"),
        Box(min: (34, 0, 26), max: (38, 24, 52), material: "metal"),
        Box(min: (-26, 0, 26), max: (-4, 24, 36), material: "metal"),
        Box(min: (-26, 0, 42), max: (-4, 24, 52), material: "metal"),
        Box(min: (4, 0, 26), max: (26, 24, 36), material: "metal"),
        Box(min: (4, 0, 42), max: (26, 24, 52), material: "metal"),
        // Corridor and duct ceilings.
        Box(min: (-34, 7, 26), max: (-26, 24, 52), material: "metal"),
        Box(min: (-4, 7, 26), max: (4, 24, 52), material: "metal"),
        Box(min: (26, 7, 26), max: (34, 24, 52), material: "metal"),
        Box(min: (-26, 6, 36), max: (-4, 24, 42), material: "metal"),
        Box(min: (4, 6, 36), max: (26, 24, 42), material: "metal"),
        // Airlock 2 (z 26..27).
        Box(min: (-38, 0, 52), max: (-32, 24, 54), material: "grid"),
        Box(min: (-28, 0, 52), max: (-2, 24, 54), material: "grid"),
        Box(min: (2, 0, 52), max: (28, 24, 54), material: "grid"),
        Box(min: (32, 0, 52), max: (38, 24, 54), material: "grid"),
        Box(min: (-32, 5, 52), max: (-28, 24, 54), material: "hazard"),
        Box(min: (-2, 5, 52), max: (2, 24, 54), material: "hazard"),
        Box(min: (28, 5, 52), max: (32, 24, 54), material: "hazard"),
        // Hub: reactor column, east balcony and its ramp, west platforms.
        Cylinder(min: (-4, 0, -4), max: (4, 24, 4), axis: Y, sides: 16, material: "emissive"),
        Box(min: (30, 5, 0), max: (38, 6, 22), material: "grid"),
        Wedge(min: (10, 0, 18), max: (30, 6, 22), rise: PosX, material: "metal"),
        Box(min: (-20, 8, 6), max: (-12, 9, 14), material: "hologram"),
        Box(min: (-38, 10, 4), max: (-30, 11, 16), material: "hologram"),
        // Spawn module cover.
        Box(min: (-20, 0, 56), max: (-12, 2, 58), material: "metal"),
        Box(min: (12, 0, 56), max: (20, 2, 58), material: "metal"),
    ],
    props: [
        (recipe: "airlock_pod", at: (-10.0, 0.0, 9.0), yaw: 0.0),
        (recipe: "space_crate", at: (8.0, 0.0, 4.0), yaw: 30.0),
        (recipe: "fuel_cell", at: (-17.0, 0.0, 33.5), yaw: 0.0),
        (recipe: "cargo_pod", at: (17.0, 0.0, 33.5), yaw: 90.0),
    ],
    spawns: [
        (at: (-16.0, 0.0, 31.0), yaw: 0.0, team: A),
        (at: (-12.0, 0.0, 31.0), yaw: 0.0, team: A),
        (at: (-8.0, 0.0, 31.0), yaw: 0.0, team: A),
        (at: (-4.0, 0.0, 31.0), yaw: 0.0, team: A),
        (at: (4.0, 0.0, 31.0), yaw: 0.0, team: A),
        (at: (8.0, 0.0, 31.0), yaw: 0.0, team: A),
        (at: (12.0, 0.0, 31.0), yaw: 0.0, team: A),
        (at: (16.0, 0.0, 31.0), yaw: 0.0, team: A),
    ],
    pickups: [
        (kind: Health, at: (0.0, 0.5, 19.5), respawn_s: 30),
        (kind: Armor, at: (17.0, 3.5, 3.0), respawn_s: 45),
        (kind: Weapon("boomer_rocket_launcher"), at: (-15.0, 0.5, 19.5), respawn_s: 60),
        (kind: Ammo, at: (15.0, 0.5, 19.5), respawn_s: 20),
    ],
    zones: [
        Box(min: (-42, -20, 0), max: (42, -4, 74), kind: KillVolume),
        Box(min: (-38, 0, 0), max: (38, 24, 24), kind: LowGravity(scale: 0.35)),
    ],
    lights: [
        (at: (0.0, 10.0, 0.0), color: (0.4, 0.7, 1.0), intensity: 2.5, range: 22.0),
        (at: (0.0, 3.0, 19.5), color: (0.8, 0.9, 1.0), intensity: 1.0, range: 8.0),
        (at: (0.0, 4.0, 31.0), color: (0.8, 0.9, 1.0), intensity: 1.2, range: 14.0),
    ],
)
